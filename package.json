{
  "name": "tidybot",
  "version": "0.1.0",
  "description": "Agent-friendly CLI for organizing files into smart folders, with plans, history and undo",
  "type": "module",
  "bin": {
    "tidybot": "./dist/cli.js"
  },
  "files": ["dist", "skills"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.12.1",
  "dependencies": {
    "commander": "^15.0.0",
    "jszip": "^3.10.2",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
