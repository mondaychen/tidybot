{
  "name": "tidybot",
  "version": "0.1.0",
  "description": "Agent-friendly CLI for organizing files into smart folders, with plans, history and undo",
  "type": "module",
  "bin": {
    "tidybot": "./dist/cli.js"
  },
  "files": [
    "dist",
    "guides"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-cmaps.mjs",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.6.0",
  "dependencies": {
    "@secretlint/core": "^13.0.7",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "mime": "^4.1.0",
    "minisearch": "^7.2.0",
    "p-map": "^7.0.8",
    "picomatch": "^4.0.7",
    "trash": "^10.1.1",
    "unpdf": "^1.8.1",
    "write-file-atomic": "^8.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/picomatch": "^4.0.3",
    "@types/write-file-atomic": "^4.0.3",
    "pdfjs-dist": "~6.1.200",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "optionalDependencies": {
    "fswin": "^3.25.1108"
  }
}
